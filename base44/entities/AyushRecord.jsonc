        "homeopathy"
      ],
      "default": "ayurveda"
    },
    "concern": {
      "type": "string",
      "required": true
    },
    "remedy": {
      "type": "string"
    },
    "practitioner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": []
}
