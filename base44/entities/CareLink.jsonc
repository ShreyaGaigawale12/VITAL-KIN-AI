{
  "name": "CareLink",
  "type": "object",
  "properties": {
    "ward_name": {
      "type": "string",
      "required": true
    },
    "relation": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "upi_id": {
      "type": "string"
    },
    "medication_adherence": {
      "type": "integer",
      "default": 0
    },
    "last_vitals_checkin": {
      "type": "string",
      "format": "date"
    },
    "sos_triggered": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": []
}
